# --- Secrets & local config (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Local machine reports (contain local paths / hardware info) ---
scripts/windows/system-info.txt

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Node / frontend ---
node_modules/
dist/
coverage/
*.tsbuildinfo

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Data / models (never commit large binaries or real logs) ---
*.gguf
*.log
data/local/
