# SecureSOC configuration template.
# Copy to `.env` and change the values. `.env` is git-ignored: never commit it.
#   PowerShell:  Copy-Item .env.example .env

# --- Runtime ---
# development | test | production  (production disables /docs and /openapi.json)
SECURESOC_ENVIRONMENT=development
SECURESOC_LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=securesoc
POSTGRES_USER=securesoc
# CHANGE THIS. Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-please

# Host port exposed on 127.0.0.1 only. 5433 avoids clashing with a local PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433

# Where the API finds the database.
#  - API running inside docker compose: overridden to `db:5432` automatically.
#  - API running on your machine (dev):  localhost + POSTGRES_HOST_PORT
SECURESOC_DB_HOST=localhost
SECURESOC_DB_PORT=5433

# --- Published ports (bound to 127.0.0.1 only) ---
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- LLM (used from Phase 6; nothing calls Ollama yet) ---
# SECURESOC_LLM_PROVIDER=ollama
# SECURESOC_OLLAMA_URL=http://localhost:11434
# SECURESOC_LLM_MODEL=qwen3:4b
